<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <title>TheRock Change Impact Report</title>
  <style>
    body { font-family: system-ui, sans-serif; margin: 2rem; max-width: 960px; line-height: 1.5; }
    h1 { color: #c41230; }
    .badge { display: inline-block; padding: 0.2rem 0.6rem; border-radius: 4px; font-weight: 600; }
    .CRITICAL { background: #fee; color: #900; }
    .HIGH { background: #ffe8cc; color: #a60; }
    .MEDIUM, .MEDIUM-HIGH { background: #fff3cd; color: #856404; }
    .LOW { background: #e8f5e9; color: #2e7d32; }
    table { border-collapse: collapse; width: 100%; margin: 1rem 0; }
    th, td { border: 1px solid #ddd; padding: 0.5rem; text-align: left; }
    th { background: #f5f5f5; }
    code { background: #f0f0f0; padding: 0.1rem 0.3rem; }
    ul.tags li { display: inline-block; background: #e3f2fd; margin: 0.2rem; padding: 0.2rem 0.5rem; border-radius: 3px; }
  </style>
</head>
<body>
  <h1>Change Impact Report (AGENTS_030)</h1>
  <p>
    <strong>Commits:</strong>
    <code>{{ report.start_sha[:8] }}</code> → <code>{{ report.end_sha[:8] }}</code>
  </p>
  <p>
    Severity:
    <span class="badge {{ report.severity }}">{{ report.severity }}</span>
    (score {{ report.blast_radius_score }}/100)
  </p>
  <p><small>Manifest mode: {{ report.manifest_mode }}</small></p>
  {% if report.manifest_notes %}
  <ul>
    {% for note in report.manifest_notes %}
    <li><small>{{ note }}</small></li>
    {% endfor %}
  </ul>
  {% endif %}

  <h2>What changed</h2>
  {% if report.changed_components %}
  <table>
    <tr><th>Name</th><th>Kind</th><th>Status</th><th>Parent</th><th>SHA change</th></tr>
    {% for item in report.changed_components %}
    <tr>
      <td><code>{{ item.name }}</code></td>
      <td>{{ item.kind }}</td>
      <td>{{ item.status }}</td>
      <td>{{ item.parent or "—" }}</td>
      <td><code>{{ item.old_sha[:8] if item.old_sha else "—" }}</code> → <code>{{ item.new_sha[:8] if item.new_sha else "—" }}</code></td>
    </tr>
    {% endfor %}
  </table>
  {% else %}
  <p>No submodule manifest changes in this range.</p>
  {% endif %}
  {% if report.changed_files %}
  <h3>Changed repository paths (git diff)</h3>
  <ul>
    {% for path in report.changed_files %}
    <li><code>{{ path }}</code></li>
    {% endfor %}
  </ul>
  {% endif %}

  {% if report.content_insights and report.content_insights.notes %}
  <h3>Content insights (CI / packaging)</h3>
  <ul>
    {% for note in report.content_insights.notes %}
    <li>{{ note }}</li>
    {% endfor %}
  </ul>
  {% endif %}
  {% if report.content_insights.test_matrix_changes and report.content_insights.test_matrix_changes.timeout_changes %}
  <h3>GHA wrapper timeout changes</h3>
  <table>
    <tr><th>Job</th><th>Old (min)</th><th>New (min)</th></tr>
    {% for t in report.content_insights.test_matrix_changes.timeout_changes %}
    <tr>
      <td><code>{{ t.job }}</code></td>
      <td>{{ t.old_minutes }}</td>
      <td>{{ t.new_minutes }}</td>
    </tr>
    {% endfor %}
  </table>
  {% endif %}

  {% if report.changed_paths_in_components %}
  <h3>Superrepo file changes by component</h3>
  <table>
    <tr><th>Component</th><th>Files changed</th><th>Sample paths</th></tr>
    {% for comp, info in report.changed_paths_in_components.items() %}
    <tr>
      <td><code>{{ comp }}</code></td>
      <td>{{ info.file_count }}</td>
      <td>
        {% for p in info.sample_paths %}
        <code>{{ p }}</code><br/>
        {% endfor %}
      </td>
    </tr>
    {% endfor %}
  </table>
  {% endif %}

  <h2>Blast radius</h2>
  <ul>
    {% for r in report.rationale %}
    <li>{{ r }}</li>
    {% endfor %}
  </ul>
  <p><strong>Source sets:</strong> {{ report.affected_source_sets | join(', ') or 'none' }}</p>
  <p><strong>Artifact groups:</strong> {{ report.affected_artifact_groups | join(', ') or 'none' }}</p>
  <p><strong>Build stages:</strong> {{ report.affected_build_stages | join(', ') or 'none' }}</p>
  <p><strong>Rollout:</strong> {{ report.rollout_strategy }}</p>

  <h2>CI recommendations</h2>
  <p><strong>test_type:</strong> <code>{{ report.ci_recommendations.test_type }}</code>
     — {{ report.ci_recommendations.test_type_reason }}</p>
  <p>Suggested PR labels:</p>
  <ul class="tags">
    {% for label in report.ci_recommendations.suggested_pr_labels %}
    <li><code>{{ label }}</code></li>
    {% endfor %}
  </ul>
  <p><strong>Test suites:</strong> {{ report.ci_recommendations.suggested_test_suites | join(', ') or 'none' }}</p>
  <p><em>{{ report.ci_recommendations.notes }}</em></p>

  <h2>Topology warnings</h2>
  <p><small>Deterministic checks for gaps between changed files and BUILD_TOPOLOGY.toml (no LLM).</small></p>
  {% if report.topology_warnings %}
  <ul>
    {% for warning in report.topology_warnings %}
    <li>{{ warning }}</li>
    {% endfor %}
  </ul>
  {% else %}
  <p><em>No topology gaps detected for this change range.</em></p>
  {% endif %}

  {% if report.executive_summary %}
  <h2>Executive summary</h2>
  <pre>{{ report.executive_summary }}</pre>
  {% endif %}

  <hr/>
  <p><small>Generated by agents/change-impact-agent — TheRock AGENTS_030 prototype</small></p>
</body>
</html>
