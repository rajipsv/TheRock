# Optional — copy to .env and fill in as needed
# copy .env.example .env   # Windows: copy agents\log-analysis-agent\.env.example agents\log-analysis-agent\.env

# GitHub: PAT with Actions read for upstream ROCm/TheRock log fetch
# GITHUB_TOKEN=ghp_...

# --- OpenAI cloud (optional agent + summary) ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# --- vLLM on MI300 (same pattern as change-impact-agent) ---
# USE_VLLM=1
# VLLM_BASE_URL=http://localhost:8000/v1
# VLLM_MODEL=Qwen3-30B-A3B
# OPENAI_API_KEY=abc-123
# VLLM_DISABLE_THINKING=1

# Auto-use vLLM for executive summary after analyze_log.py
# LOG_SUMMARY_BACKEND=vllm

# KB embeddings need OpenAI unless disabled
# LOG_AGENT_DISABLE_EMBEDDINGS=1
# LOG_AGENT_TEST_RUN_ID=12345678
