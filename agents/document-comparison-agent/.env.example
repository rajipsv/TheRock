# vLLM server (Qwen3-30B-A3B on port 8000)
BASE_URL=http://localhost:8000/v1
OPENAI_API_KEY=abc-123
LLM_MODEL=Qwen3-30B-A3B
LLM_TIMEOUT_SECONDS=180

USE_LLM=true
USE_LLM_ALIGNMENT_FALLBACK=true
ALIGNMENT_SCORE_THRESHOLD=0.4

# GitHub policy dataset cache (MIT license)
GITHUB_REPO=kornosk/GDPR-similarity-comparison
GITHUB_BRANCH=main
GITHUB_CACHE_DIR=data/github/gdpr-similarity-comparison
